# Required: my.telegram.org -> API development tools
API_ID=
API_HASH=
# Required: @BotFather -> /newbot
BOT_TOKEN=
# Numeric Telegram user IDs; only these users can open /panel
ADMIN_IDS=
DATA_DIR=data

# Optional: OpenAI-compatible translation endpoint. URL must end in /v1.
# Translations are cached across all users. Only public source readings are sent.
# Without these values, the UI is localized and readings are shown in English.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional separate proxies. Example socks5://username:password@127.0.0.1:1080
HTTP_PROXY_URL=
TELETHON_PROXY_URL=
